function Write-Log {
    param(
        [Parameter(Mandatory)] [string]$Message,
        [ValidateSet('Info','Warn','Error','Success')] [string]$Level = 'Info'
    )

    $timestamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $line = "[$timestamp] [$Level] $Message"

    if ($script:txtLog) {
        $script:txtLog.AppendText($line + [Environment]::NewLine)
        $script:txtLog.SelectionStart = $script:txtLog.Text.Length
        $script:txtLog.ScrollToCaret()
    }
}

function Show-Error {
    param([string]$Message)
    [System.Windows.Forms.MessageBox]::Show($Message, $script:AppName, 'OK', 'Error') | Out-Null
    Write-Log -Message $Message -Level Error
}

function Show-Info {
    param([string]$Message)
    [System.Windows.Forms.MessageBox]::Show($Message, $script:AppName, 'OK', 'Information') | Out-Null
    Write-Log -Message $Message -Level Info
}

function Show-YesNo {
    param([string]$Message)
    return [System.Windows.Forms.MessageBox]::Show($Message, $script:AppName, 'YesNo', 'Question')
}

function Get-UserSettingsRootPath {
    $settingsRoot = Join-Path $env:APPDATA 'JSS'
    if (-not (Test-Path -Path $settingsRoot)) {
        [void](New-Item -Path $settingsRoot -ItemType Directory -Force)
    }
    return $settingsRoot
}

function Get-ProfileSettingsFolderPath {
    $profilesRoot = Join-Path (Get-UserSettingsRootPath) 'profiles'
    if (-not (Test-Path -Path $profilesRoot)) {
        [void](New-Item -Path $profilesRoot -ItemType Directory -Force)
    }
    return $profilesRoot
}

function Get-SafeProfileName {
    param([string]$ProfileName)

    if ([string]::IsNullOrWhiteSpace($ProfileName)) {
        return 'Default'
    }

    $clean = ($ProfileName -replace '[\\/:*?"<>|]', '_').Trim()
    if ([string]::IsNullOrWhiteSpace($clean)) { return 'Default' }
    return $clean
}

function Get-ProfileSettingsFilePath {
    param([string]$ProfileName = 'Default')
    $safeName = Get-SafeProfileName -ProfileName $ProfileName
    return (Join-Path (Get-ProfileSettingsFolderPath) "$safeName.json")
}

function Get-ActiveProfileFilePath {
    return (Join-Path (Get-UserSettingsRootPath) 'active-profile.txt')
}

function Get-ActiveProfileName {
    $path = Get-ActiveProfileFilePath
    if (-not (Test-Path -Path $path)) { return 'Default' }
    try {
        $name = (Get-Content -Path $path -Raw).Trim()
        if ([string]::IsNullOrWhiteSpace($name)) { return 'Default' }
        return (Get-SafeProfileName -ProfileName $name)
    }
    catch {
        return 'Default'
    }
}

function Set-ActiveProfileName {
    param([string]$ProfileName)
    $safeName = Get-SafeProfileName -ProfileName $ProfileName
    $safeName | Set-Content -Path (Get-ActiveProfileFilePath) -Encoding UTF8
}

function Get-ProfileNames {
    $profilesRoot = Get-ProfileSettingsFolderPath
    $files = @(Get-ChildItem -Path $profilesRoot -Filter '*.json' -File -ErrorAction SilentlyContinue)
    $names = @('Default')
    foreach ($file in $files) {
        if ($file.BaseName -ne 'Default') {
            $names += $file.BaseName
        }
    }
    return @($names | Sort-Object -Unique)
}

function Get-UserSettings {
    param([string]$ProfileName = 'Default')
    $path = Get-ProfileSettingsFilePath -ProfileName $ProfileName
    if (-not (Test-Path -Path $path)) { return $null }

    try {
        return (Get-Content -Path $path -Raw | ConvertFrom-Json)
    }
    catch {
        Write-Log "Unable to load user settings file at $path. Using defaults." -Level Warn
        return $null
    }
}

function Save-UserSettings {
    param(
        [Parameter(Mandatory)] [System.Windows.Forms.TabControl]$TabControl,
        [string]$ProfileName = 'Default'
    )

    $path = Get-ProfileSettingsFilePath -ProfileName $ProfileName
    $payload = [pscustomobject]@{
        HeaderColor = @{
            R = $script:HeaderColor.R
            G = $script:HeaderColor.G
            B = $script:HeaderColor.B
        }
        AccentColor = @{
            R = $script:AccentColor.R
            G = $script:AccentColor.G
            B = $script:AccentColor.B
        }
        DarkMode = [bool]$script:IsDarkMode
        TabOrder = @($TabControl.TabPages | ForEach-Object { $_.Text })
        CookieClicker = (Get-CookieClickerSaveState)
    }

    $payload | ConvertTo-Json -Depth 4 | Set-Content -Path $path -Encoding UTF8
    Set-ActiveProfileName -ProfileName $ProfileName
}

function Test-HostPing {
    param(
        [Parameter(Mandatory)] [string]$ComputerName
    )

    try {
        return Test-Connection -ComputerName $ComputerName -Count 1 -Quiet -ErrorAction Stop
    }
    catch {
        return $false
    }
}

function Test-RemoteAccess {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    try {
        Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock { $env:COMPUTERNAME } -ErrorAction Stop | Out-Null
        return $true
    }
    catch {
        Show-Error "Unable to connect to $ComputerName through PowerShell remoting.`r`n$($_.Exception.Message)"
        return $false
    }
}

function Format-Uptime {
    param([datetime]$LastBoot)

    if (-not $LastBoot) { return '' }
    $span = (Get-Date) - $LastBoot
    return ('{0}d {1}h {2}m' -f [int]$span.TotalDays, $span.Hours, $span.Minutes)
}

function Get-RemoteSystemInfo {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
        $cs = Get-CimInstance Win32_ComputerSystem
        $bios = Get-CimInstance Win32_BIOS
        $os = Get-CimInstance Win32_OperatingSystem
        $disk = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'"
        $net = Get-CimInstance Win32_NetworkAdapterConfiguration | Where-Object {
            $_.IPEnabled -eq $true -and $_.IPAddress
        } | Select-Object -First 1

        $blState = ''
        try {
            $bl = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction Stop
            $blState = "$($bl.ProtectionStatus) / $($bl.VolumeStatus)"
        }
        catch {
            $blState = 'Unavailable'
        }

        [pscustomobject]@{
            ComputerName = $env:COMPUTERNAME
            LoggedInUser  = [string]$cs.UserName
            Model         = [string]$cs.Model
            SerialNumber  = [string]$bios.SerialNumber
            OSVersion     = [string]$os.Caption
            BuildNumber   = [string]$os.BuildNumber
            LastBoot      = [datetime]$os.LastBootUpTime
            Uptime        = ((Get-Date) - [datetime]$os.LastBootUpTime).ToString()
            IPAddress     = [string](($net.IPAddress | Where-Object { $_ -notlike 'fe80*' } | Select-Object -First 1))
            FreeSpaceGB   = if ($disk.Size) { [math]::Round($disk.FreeSpace / 1GB, 2) } else { '' }
            TotalSpaceGB  = if ($disk.Size) { [math]::Round($disk.Size / 1GB, 2) } else { '' }
            BitLocker     = $blState
        }
    } -ErrorAction Stop
}

function Get-RemoteUserProfiles {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    $profiles = Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
        Get-CimInstance Win32_UserProfile |
            Where-Object {
                $_.LocalPath -like 'C:\Users\*' -and
                $_.Special -eq $false
            } |
            Select-Object @{
                Name='LocalPath'
                Expression={ $_.LocalPath }
            }, @{
                Name='SID'
                Expression={ $_.SID }
            }, @{
                Name='Loaded'
                Expression={ $_.Loaded }
            }, @{
                Name='LastUseTime'
                Expression={
                    try {
                        if ($_.LastUseTime) {
                            [string]$_.LastUseTime
                        }
                        else {
                            ''
                        }
                    }
                    catch {
                        ''
                    }
                }
            }
    } -ErrorAction Stop

    return $profiles
}

function Remove-RemoteUserProfile {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential,
        [Parameter(Mandatory)] [string]$Sid,
        [Parameter(Mandatory)] [string]$LocalPath
    )

    Invoke-Command -ComputerName $ComputerName -Credential $Credential -ArgumentList $Sid, $LocalPath -ScriptBlock {
        param($Sid, $LocalPath)

        $profile = Get-CimInstance Win32_UserProfile | Where-Object { $_.SID -eq $Sid }
        if (-not $profile) {
            throw "Profile with SID $Sid was not found."
        }

        if ($profile.Loaded) {
            throw "Profile is currently loaded and cannot be deleted safely: $LocalPath"
        }

        Remove-CimInstance -InputObject $profile -ErrorAction Stop

        if (Test-Path $LocalPath) {
            Remove-Item -Path $LocalPath -Recurse -Force -ErrorAction Stop
        }

        $regPath = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList\$Sid"
        if (Test-Path $regPath) {
            Remove-Item -Path $regPath -Recurse -Force -ErrorAction Stop
        }

        [pscustomobject]@{
            SID     = $Sid
            Path    = $LocalPath
            Removed = $true
        }
    } -ErrorAction Stop
}

function Get-BitLockerKeyFromArchive {
    param(
        [Parameter(Mandatory)] [string]$ComputerName
    )

    $archiveFile = "PLACEHOLDER"

    if (-not (Test-Path $archiveFile)) {
        throw "Archived BitLocker file not found: $archiveFile"
    }

    $content = Get-Content -Path $archiveFile -ErrorAction Stop
    $recoveryKey = $null

    foreach ($line in $content) {
        if ($line -match '(?<!\d)(\d{6}-\d{6}-\d{6}-\d{6}-\d{6}-\d{6}-\d{6}-\d{6})(?!\d)') {
            $recoveryKey = $matches[1]
            break
        }
    }

    if (-not $recoveryKey) {
        $recoveryLine = $content | Where-Object { $_ -match 'Recovery|Password|Key' } | Select-Object -First 1
        if ($recoveryLine) {
            $recoveryKey = $recoveryLine.Trim()
        }
    }

    return [pscustomobject]@{
        FilePath    = $archiveFile
        RecoveryKey = $recoveryKey
        FileContent = ($content -join [Environment]::NewLine)
    }
}

function Enable-RemoteBitLocker {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    $driverScript = "PLACEHOLDER"
    $shareSource  = "PLACEHOLDER"
    $destFolder   = "PLACEHOLDER"
    $destFile     = Join-Path $destFolder "${ComputerName}_BLout.txt"

    if (-not (Test-Path $driverScript)) {
        throw "BitLocker driver script not found: $driverScript"
    }

    if (-not (Test-Path $destFolder)) {
        throw "Destination folder not reachable: $destFolder"
    }

    Invoke-Command -ComputerName $ComputerName -Credential $Credential -FilePath $driverScript -ErrorAction Stop

    $maxAttempts = 12
    $attempt = 0
    do {
        Start-Sleep -Seconds 5
        $attempt++
    } until ((Test-Path $shareSource) -or ($attempt -ge $maxAttempts))

    if (-not (Test-Path $shareSource)) {
        throw "Expected output file was not found on remote host: $shareSource"
    }

    Move-Item -Path $shareSource -Destination $destFile -Force -ErrorAction Stop

    if (-not (Test-Path $destFile)) {
        throw "Unable to confirm moved BitLocker file at: $destFile"
    }

    return Get-BitLockerKeyFromArchive -ComputerName $ComputerName
}

function Restart-RemoteComputerSafe {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
        Restart-Computer -Force
    } -ErrorAction Stop
}

function Shutdown-RemoteComputerSafe {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
        Stop-Computer -Force
    } -ErrorAction Stop
}

function Invoke-GeneralRemoteCommand {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential,
        [Parameter(Mandatory)] [ValidateSet('GPUpdate','IPConfig','FlushDNS','ReleaseRenew')] [string]$Action
    )

    switch ($Action) {
        'GPUpdate' {
            return Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
                gpupdate /force | Out-String
            } -ErrorAction Stop
        }
        'IPConfig' {
            return Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
                ipconfig /all | Out-String
            } -ErrorAction Stop
        }
        'FlushDNS' {
            return Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
                ipconfig /flushdns | Out-String
            } -ErrorAction Stop
        }
        'ReleaseRenew' {
            return Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
                $release = ipconfig /release | Out-String
                Start-Sleep -Seconds 4
                $renew = ipconfig /renew | Out-String
                "$release`r`n$renew"
            } -ErrorAction Stop
        }
    }
}

function Invoke-RemoteWindowsUpdate {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential,
        [Parameter(Mandatory)] [ValidateSet('Check','Install')] [string]$Mode
    )

    return Invoke-Command -ComputerName $ComputerName -Credential $Credential -ArgumentList $Mode -ScriptBlock {
        param([string]$Mode)

        $session = New-Object -ComObject Microsoft.Update.Session
        $searcher = $session.CreateUpdateSearcher()
        $searchResult = $searcher.Search("IsInstalled=0 and Type='Software' and IsHidden=0")
        $pending = $searchResult.Updates
        $pendingCount = [int]$pending.Count

        $titles = @()
        for ($i = 0; $i -lt $pendingCount; $i++) {
            $titles += [string]$pending.Item($i).Title
        }

        if ($Mode -eq 'Check') {
            return [pscustomobject]@{
                Mode           = 'Check'
                PendingCount   = $pendingCount
                UpdateTitles   = $titles
                InstalledCount = 0
                RebootRequired = $false
                ResultCode     = 'NotRun'
            }
        }

        if ($pendingCount -eq 0) {
            return [pscustomobject]@{
                Mode           = 'Install'
                PendingCount   = 0
                UpdateTitles   = @()
                InstalledCount = 0
                RebootRequired = $false
                ResultCode     = 'NoUpdates'
            }
        }

        $collection = New-Object -ComObject Microsoft.Update.UpdateColl
        for ($i = 0; $i -lt $pendingCount; $i++) {
            [void]$collection.Add($pending.Item($i))
        }

        $downloader = $session.CreateUpdateDownloader()
        $downloader.Updates = $collection
        [void]$downloader.Download()

        $installer = $session.CreateUpdateInstaller()
        $installer.Updates = $collection
        $installResult = $installer.Install()

        $installedCount = 0
        for ($i = 0; $i -lt $pendingCount; $i++) {
            if ($installResult.GetUpdateResult($i).ResultCode -eq 2) {
                $installedCount++
            }
        }

        return [pscustomobject]@{
            Mode           = 'Install'
            PendingCount   = $pendingCount
            UpdateTitles   = $titles
            InstalledCount = $installedCount
            RebootRequired = [bool]$installResult.RebootRequired
            ResultCode     = [string]$installResult.ResultCode
        }
    } -ErrorAction Stop
}

function Get-WindowsUpdateResultCodeMeaning {
    param($ResultCode)

    $codeText = [string]$ResultCode
    $codeNumber = $null
    [void][int]::TryParse($codeText, [ref]$codeNumber)

    if ($null -eq $codeNumber) {
        return 'Unknown/Not numeric'
    }

    switch ($codeNumber) {
        0 { return 'Not Started' }
        1 { return 'In Progress' }
        2 { return 'Succeeded' }
        3 { return 'Succeeded With Errors' }
        4 { return 'Failed' }
        5 { return 'Aborted' }
        default { return 'Unknown' }
    }
}

function Invoke-RemotePopup {
    param(
        [Parameter(Mandatory)] [string]$ComputerName,
        [Parameter(Mandatory)] [pscredential]$Credential,
        [Parameter(Mandatory)] [string]$Message
    )
    try {
        $result = Invoke-Command -ComputerName $ComputerName -Credential $Credential -ScriptBlock {
            $msgPath = Join-Path $env:SystemRoot 'System32\msg.exe'
            if (-not (Test-Path -Path $msgPath)) {
                throw 'msg.exe was not found on the target machine.'
            }

            # Send to all active sessions on the local target machine.
            $cmdOutput = & $msgPath * /time:120 $using:Message 2>&1 | Out-String
            $exitCode = $LASTEXITCODE

            [pscustomobject]@{
                ExitCode = $exitCode
                Output   = $cmdOutput
            }
        } -ErrorAction Stop

        if ($result.ExitCode -eq 0) {
            return $true
        }

        $detail = if ([string]::IsNullOrWhiteSpace([string]$result.Output)) { 'No additional details returned.' } else { [string]$result.Output }
        Write-Log "Popup command failed on $ComputerName with exit code $($result.ExitCode). Details: $detail" -Level Error
        return $false
    }
    catch {
        Write-Log "Error sending popup to ${ComputerName}: $($_.Exception.Message)" -Level Error
        return $false
    }
}

function Get-ComputerTargetsFromInput {
    param(
        [string]$RawComputerInput,
        [string]$FilePathInput
    )

    $targets = @()

    if (-not [string]::IsNullOrWhiteSpace($RawComputerInput)) {
        $normalized = $RawComputerInput -replace '[,;]+', [Environment]::NewLine
        $targets += ($normalized -split '[\r\n]+' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
    }

    if (-not [string]::IsNullOrWhiteSpace($FilePathInput)) {
        if (-not (Test-Path -Path $FilePathInput)) {
            throw "The file path does not exist: $FilePathInput"
        }

        $fileTargets = Get-Content -Path $FilePathInput -ErrorAction Stop |
            ForEach-Object { $_.Trim() } |
            Where-Object { $_ -and -not $_.StartsWith('#') }

        $targets += $fileTargets
    }

    return @($targets | Sort-Object -Unique)
}

function Ensure-ActiveDirectoryModule {
    if (Get-Module -Name ActiveDirectory) {
        return
    }

    try {
        Import-Module ActiveDirectory -ErrorAction Stop
    }
    catch {
        throw "ActiveDirectory module is required but could not be loaded. $($_.Exception.Message)"
    }
}

function Get-NextUnixUidNumber {
    param(
        [Parameter(Mandatory)] [string]$DomainDn,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    $existing = Get-ADObject -SearchBase $DomainDn -LDAPFilter '(uidNumber=*)' -Properties uidNumber -Credential $Credential -ErrorAction Stop |
        ForEach-Object { [int]$_.uidNumber } |
        Sort-Object -Descending

    if ($existing.Count -gt 0) {
        return ([int]$existing[0] + 1)
    }

    return 11001
}

function New-ADPl2User {
    param(
        [Parameter(Mandatory)] [string]$FirstName,
        [Parameter(Mandatory)] [string]$LastName,
        [Parameter(Mandatory)] [string]$OuCode,
        [Parameter(Mandatory)] [string]$Password,
        [Parameter(Mandatory)] [string]$DomainDn,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Ensure-ActiveDirectoryModule

    $first = $FirstName.Trim()
    $last = $LastName.Trim()
    $ou = $OuCode.Trim().ToLower()

    if ($first.Length -lt 1 -or $last.Length -lt 1 -or $ou.Length -lt 1) {
        throw 'First name, last name, and OU are required.'
    }

    $firstInitialLower = $first.Substring(0, 1).ToLower()
    $firstInitialUpper = $first.Substring(0, 1)
    if ($ou -eq 'PLACEHOLDER') {
        $username = ("{0}{1}" -f $last, $firstInitialLower).ToLower()
        $displayName = "$first $last"
    }
    else {
        $username = ("{0}{1}_{2}" -f $last, $firstInitialUpper, $ou).ToLower()
        $displayName = "$first $last ($ou)"
    }

    $email = "PLACEHOLDER"
    $secGroupPath = "OU=$ou,OU=SecurityGroups,OU=Groups,OU=PL2,$DomainDn"
    $securePassword = ConvertTo-SecureString -String $Password -AsPlainText -Force

    $existingUser = Get-ADUser -Filter "SamAccountName -eq '$username'" -Credential $Credential -ErrorAction SilentlyContinue
    if ($existingUser) {
        throw "User '$username' already exists in Active Directory."
    }

    $nextId = Get-NextUnixUidNumber -DomainDn $DomainDn -Credential $Credential
    $homeDir = "/home/$username"

    New-ADUser -Name $username `
        -SamAccountName $username `
        -UserPrincipalName $email `
        -Path $secGroupPath `
        -GivenName $first `
        -Surname $last `
        -DisplayName $displayName `
        -AccountPassword $securePassword `
        -PasswordNeverExpires $false `
        -Enabled $true `
        -ChangePasswordAtLogon $true `
        -Credential $Credential `
        -ErrorAction Stop

    Set-ADUser -Identity $username -Replace @{
        msSFU30Name         = $username
        msSFU30NisDomain    = 'PLACEHOLDER'
        loginShell          = '/bin/bash'
        uidNumber           = [string]$nextId
        uid                 = $username
        gidNumber           = '11000'
        unixHomeDirectory   = $homeDir
        primaryGroupID      = '513'
        unixUserPassword    = 'ABCD!efg12345$67890'
        telephoneNumber     = [string]$nextId
        mail                = $email
    } -Credential $Credential -ErrorAction Stop

    Add-ADGroupMember -Identity 'RDesktop Users' -Members $username -Credential $Credential -ErrorAction Stop
    $ouNonAdminGroup = "$ou-nonadmins"
    Add-ADGroupMember -Identity $ouNonAdminGroup -Members $username -Credential $Credential -ErrorAction Stop

    $newUser = Get-ADUser -Identity $username -Properties DistinguishedName -Credential $Credential -ErrorAction Stop
    Rename-ADObject -Identity $newUser.DistinguishedName -NewName $displayName -Credential $Credential -ErrorAction Stop

    return [pscustomobject]@{
        UserName    = $username
        DisplayName = $displayName
        Email       = $email
        UidNumber   = $nextId
    }
}

function Remove-ADPl2User {
    param(
        [Parameter(Mandatory)] [string]$UserName,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Ensure-ActiveDirectoryModule

    $targetUser = Get-ADUser -Identity $UserName -Properties DisplayName -Credential $Credential -ErrorAction Stop
    Remove-ADUser -Identity $targetUser.DistinguishedName -Credential $Credential -Confirm:$false -ErrorAction Stop

    return [pscustomobject]@{
        UserName    = [string]$targetUser.SamAccountName
        DisplayName = [string]$targetUser.DisplayName
    }
}

function Search-ADPl2Users {
    param(
        [Parameter(Mandatory)] [string]$SearchTerm,
        [Parameter(Mandatory)] [pscredential]$Credential
    )

    Ensure-ActiveDirectoryModule

    $term = $SearchTerm.Trim()
    if ([string]::IsNullOrWhiteSpace($term)) {
        return @()
    }

    $safeTerm = $term.Replace("'", "''")
    $filter = "SamAccountName -like '*$safeTerm*' -or Name -like '*$safeTerm*' -or DisplayName -like '*$safeTerm*' -or GivenName -like '*$safeTerm*' -or Surname -like '*$safeTerm*' -or mail -like '*$safeTerm*'"

    $results = Get-ADUser -Filter $filter -Properties DisplayName, mail -Credential $Credential -ErrorAction Stop |
        Sort-Object SamAccountName |
        Select-Object -First 200

    return @($results)
}

function Format-CookieNumber {
    param([double]$Value)

    if ($Value -ge 1000000000000) { return ('{0:N2}T' -f ($Value / 1000000000000.0)) }
    if ($Value -ge 1000000000) { return ('{0:N2}B' -f ($Value / 1000000000.0)) }
    if ($Value -ge 1000000) { return ('{0:N2}M' -f ($Value / 1000000.0)) }
    if ($Value -ge 1000) { return ('{0:N2}K' -f ($Value / 1000.0)) }
    if ($Value -ge 100) { return ('{0:N0}' -f $Value) }
    return ('{0:N1}' -f $Value)
}

