    $modeText = if ($script:IsDarkMode) { 'enabled' } else { 'disabled' }
    Write-Log "Dark mode $modeText for profile '$(Get-SelectedSettingsProfileName)'." -Level Info
})

$btnApplyTheme.Add_Click({
    Apply-AppTheme
    $selectedProfile = Get-SelectedSettingsProfileName
    Save-CurrentProfileSettings
    Write-Log "Custom theme applied to profile '$selectedProfile'." -Level Success

    $script:ApplyThemeClickCount++
    if ((-not $script:SecretUnlocked) -and ($script:ApplyThemeClickCount -ge 7)) {
        $secretTab = Initialize-SecretTab -TabControl $tabs
        $tabs.SelectedTab = $secretTab
        $script:SecretUnlocked = $true
        Save-CurrentProfileSettings
        Write-Log "Easter egg unlocked: Joe's Cookie Clicker is now available." -Level Success
        Show-Info "Secret tab unlocked! Joe's Cookie Clicker is live."
    }
})

$btnResetTheme.Add_Click({
    $script:HeaderColor = $script:DefaultHeaderColor
    $script:AccentColor = $script:DefaultAccentColor
    Update-ThemePreview
    Apply-AppTheme
    $selectedProfile = Get-SelectedSettingsProfileName
    Save-CurrentProfileSettings
    Write-Log "Theme reset to default colors for profile '$selectedProfile'." -Level Info
})

$btnTabUp.Add_Click({
    $idx = $lstTabOrder.SelectedIndex
    if ($idx -le 0) { return }

    $item = $lstTabOrder.Items[$idx]
    $lstTabOrder.Items.RemoveAt($idx)
    $lstTabOrder.Items.Insert($idx - 1, $item)
    $lstTabOrder.SelectedIndex = $idx - 1
})

$btnTabDown.Add_Click({
    $idx = $lstTabOrder.SelectedIndex
    if ($idx -lt 0 -or $idx -ge ($lstTabOrder.Items.Count - 1)) { return }

    $item = $lstTabOrder.Items[$idx]
    $lstTabOrder.Items.RemoveAt($idx)
    $lstTabOrder.Items.Insert($idx + 1, $item)
    $lstTabOrder.SelectedIndex = $idx + 1
})

$btnSaveTabOrder.Add_Click({
    Apply-TabOrderFromList
    $selectedProfile = Get-SelectedSettingsProfileName
    Save-CurrentProfileSettings
    Refresh-TabOrderList
    Write-Log "Tab order saved for profile '$selectedProfile'." -Level Success
})

$btnSaveAsProfile.Add_Click({
    $profileName = [Microsoft.VisualBasic.Interaction]::InputBox(
        'Enter a name for this settings profile:',
        'Save Settings Profile As',
        'My Profile'
    )

    if ([string]::IsNullOrWhiteSpace($profileName)) {
        Write-Log 'Save As profile canceled.' -Level Warn
        return
    }

    $safeName = Get-SafeProfileName -ProfileName $profileName
    Save-UserSettings -TabControl $tabs -ProfileName $safeName
    Refresh-SettingsProfileDropdown
    $cmbSettingsProfile.SelectedItem = $safeName
    Write-Log "Profile saved as '$safeName'." -Level Success
})

$btnLoadProfile.Add_Click({
    if (-not $cmbSettingsProfile.SelectedItem) {
        Show-Error 'Select a profile first.'
        return
    }

    $selectedProfile = [string]$cmbSettingsProfile.SelectedItem
    Apply-SettingsProfile -ProfileName $selectedProfile
    Write-Log "Loaded profile '$selectedProfile'." -Level Success
})

