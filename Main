# -----------------------------
# Events - Delete Profiles
# -----------------------------
$btnDeletePing.Add_Click({ Invoke-PingButton -ComputerName $txtDeleteComputer.Text.Trim() })

$btnLoadProfiles.Add_Click({
    $computer = $txtDeleteComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    $tableProfiles.Rows.Clear()
    Write-Log "Loading profiles from $computer..."

    try {
        if (-not (Test-RemoteAccess -ComputerName $computer -Credential $script:AdminCredential)) {
            return
        }

        $profiles = Get-RemoteUserProfiles -ComputerName $computer -Credential $script:AdminCredential

        foreach ($p in $profiles) {
            $userName = Split-Path $p.LocalPath -Leaf
            $row = $tableProfiles.NewRow()
            $row['Select'] = $false
            $row['UserName'] = $userName
            $row['LocalPath'] = $p.LocalPath
            $row['SID'] = $p.SID
            $row['Loaded'] = [string]$p.Loaded
            $row['LastUseTime'] = [string]$p.LastUseTime
            [void]$tableProfiles.Rows.Add($row)
        }

        Write-Log "Loaded $($profiles.Count) profiles from $computer." -Level Success

        if ($profiles.Count -eq 0) {
            Show-Info "No non-special user profiles were found on $computer."
        }
    }
    catch {
        Show-Error "Failed to load profiles from $computer.`r`n$($_.Exception.Message)"
    }
})

$btnDeleteProfiles.Add_Click({
    $computer = $txtDeleteComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    $selectedRows = @($tableProfiles.Rows | Where-Object { $_.Select -eq $true })
    if (-not $selectedRows -or $selectedRows.Count -eq 0) {
        Show-Error 'Select at least one profile to delete.'
        return
    }

    $profileList = ($selectedRows | ForEach-Object { $_.UserName }) -join ', '
    $confirm = Show-YesNo "This will permanently delete the selected user profile(s) from $($computer):`r`n`r`n$profileList`r`n`r`nContinue?"
    if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) {
        Write-Log 'Profile deletion canceled by user.' -Level Warn
        return
    }

    foreach ($row in $selectedRows) {
        try {
            Write-Log "Deleting profile $($row.UserName) from $computer..."
            Remove-RemoteUserProfile -ComputerName $computer -Credential $script:AdminCredential -Sid $row.SID -LocalPath $row.LocalPath | Out-Null
            Write-Log "Deleted profile $($row.UserName) from $computer." -Level Success
        }
        catch {
            Show-Error "Failed to delete profile $($row.UserName) from $computer.`r`n$($_.Exception.Message)"
        }
    }

    $btnLoadProfiles.PerformClick()
})

# -----------------------------
# Events - Account Management
# -----------------------------
$btnCreateAccount.Add_Click({
    $first = $txtAcctFirstName.Text.Trim()
    $last = $txtAcctLastName.Text.Trim()
    $ou = $txtAcctOu.Text.Trim()
    $password = $txtAcctPassword.Text
    $domainDn = $txtAcctDomain.Text.Trim()

    if ([string]::IsNullOrWhiteSpace($first) -or [string]::IsNullOrWhiteSpace($last) -or [string]::IsNullOrWhiteSpace($ou)) {
        Show-Error 'First name, last name, and OU are required to create an account.'
        return
    }

    $previewInitial = $first.Substring(0, 1)
    $previewUser = if ($ou.ToLower() -eq 'PLACEHOLDER') {
        ("{0}{1}" -f $last, $previewInitial.ToLower()).ToLower()
    }
    else {
        ("{0}{1}_{2}" -f $last, $previewInitial, $ou.ToLower()).ToLower()
    }
    $previewDisplay = if ($ou.ToLower() -eq 'PLACEHOLDER') { "$first $last" } else { "$first $last ($($ou.ToLower()))" }
    $previewEmail = "PLACEHOLDER"

    $ok = Show-YesNo "Create '$previewDisplay' with username '$previewUser' and email '$previewEmail'?"
    if ($ok -ne [System.Windows.Forms.DialogResult]::Yes) {
        Write-Log "Create account canceled for proposed user $previewUser." -Level Warn
        return
    }

    try {
        Write-Log "Creating AD account for $first $last in OU $ou..."
        $result = New-ADPl2User -FirstName $first -LastName $last -OuCode $ou -Password $password -DomainDn $domainDn -Credential $script:AdminCredential
        $msg = "$($result.DisplayName) created successfully. Username: $($result.UserName), Email: $($result.Email), UID: $($result.UidNumber)"
        $txtAcctOutput.AppendText($msg + [Environment]::NewLine)
        Write-Log $msg -Level Success
    }
    catch {
        Show-Error "Failed to create AD account for $first $last.`r`n$($_.Exception.Message)"
    }
})

$btnSearchADUsers.Add_Click({
    $term = $txtSearchAdUser.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($term)) {
        Show-Error 'Enter a name, username, or email fragment to search AD.'
        return
    }

    $tableADUserSearch.Rows.Clear()
    try {
        Write-Log "Searching AD users for '$term'..."
        $results = Search-ADPl2Users -SearchTerm $term -Credential $script:AdminCredential
        foreach ($user in $results) {
            [void]$tableADUserSearch.Rows.Add([string]$user.SamAccountName, [string]$user.DisplayName, [string]$user.mail)
        }

        Write-Log "AD search returned $($results.Count) account(s) for '$term'." -Level Success
        if ($results.Count -eq 0) {
            $txtAcctOutput.AppendText("No AD accounts found for search '$term'." + [Environment]::NewLine)
        }
    }
    catch {
        Show-Error "AD search failed for '$term'.`r`n$($_.Exception.Message)"
    }
})

$btnUseSelectedADUser.Add_Click({
    if ($dgvADUserSearch.SelectedRows.Count -lt 1) {
        Show-Error 'Select a user from search results first.'
        return
    }

    $selectedUsername = [string]$dgvADUserSearch.SelectedRows[0].Cells['Username'].Value
    if (-not [string]::IsNullOrWhiteSpace($selectedUsername)) {
        $txtDeleteAcctUser.Text = $selectedUsername
    }
})

$btnDeleteAccount.Add_Click({
    $username = $txtDeleteAcctUser.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($username) -and $dgvADUserSearch.SelectedRows.Count -gt 0) {
        $username = [string]$dgvADUserSearch.SelectedRows[0].Cells['Username'].Value
    }

    if ([string]::IsNullOrWhiteSpace($username)) {
        Show-Error 'Enter the username or select a user from AD search results to delete from AD.'
        return
    }

    $ok = Show-YesNo "Delete AD account '$username'? This cannot be undone."
    if ($ok -ne [System.Windows.Forms.DialogResult]::Yes) {
        Write-Log "Delete account canceled for $username." -Level Warn
        return
    }

    try {
        Write-Log "Deleting AD account $username..."
        $result = Remove-ADPl2User -UserName $username -Credential $script:AdminCredential
        $msg = "Deleted AD account $($result.UserName) ($($result.DisplayName))."
        $txtAcctOutput.AppendText($msg + [Environment]::NewLine)
        Write-Log $msg -Level Success
    }
    catch {
        Show-Error "Failed to delete AD account $username.`r`n$($_.Exception.Message)"
    }
})

# -----------------------------
# Events - BitLocker
# -----------------------------
$btnBLPing.Add_Click({ Invoke-PingButton -ComputerName $txtBLComputer.Text.Trim() })

$btnEnableBL.Add_Click({
    $computer = $txtBLComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    $txtBLKey.Text = ''
    $txtBLFile.Text = ''
    $btnBLReboot.Enabled = $false

    try {
        Write-Log "Starting BitLocker workflow on $computer using enableBL_Alldrives.ps1..."

        if (-not (Test-RemoteAccess -ComputerName $computer -Credential $script:AdminCredential)) {
            return
        }

        $result = Enable-RemoteBitLocker -ComputerName $computer -Credential $script:AdminCredential
        $txtBLKey.Text = [string]$result.RecoveryKey
        $txtBLFile.Text = [string]$result.FileContent
        $btnBLReboot.Enabled = $true

        Write-Log "BitLocker workflow completed on $computer. Output moved to PLACEHOLDER and recovery key displayed." -Level Success

        $prompt = Show-YesNo "Check the above key. Proceed with rebooting machine?"
        if ($prompt -eq [System.Windows.Forms.DialogResult]::Yes) {
            Restart-RemoteComputerSafe -ComputerName $computer -Credential $script:AdminCredential
            Write-Log "Reboot command sent to $computer." -Level Success
        }
        else {
            Write-Log "Reboot declined by user for $computer." -Level Warn
        }
    }
    catch {
        Show-Error "BitLocker workflow failed for $computer.`r`n$($_.Exception.Message)"
    }
})

$btnBLReboot.Add_Click({
    $computer = $txtBLComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    $confirm = Show-YesNo "Proceed with rebooting $computer?"
    if ($confirm -eq [System.Windows.Forms.DialogResult]::Yes) {
        try {
            Restart-RemoteComputerSafe -ComputerName $computer -Credential $script:AdminCredential
            Write-Log "Reboot command sent to $computer." -Level Success
        }
        catch {
            Show-Error "Failed to reboot $computer.`r`n$($_.Exception.Message)"
        }
    }
})

$btnBLLookup.Add_Click({
    $computer = $txtBLLookupComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    try {
        Write-Log "Looking up archived BitLocker key for $computer..."
        $result = Get-BitLockerKeyFromArchive -ComputerName $computer
        $txtBLKey.Text = [string]$result.RecoveryKey
        $txtBLFile.Text = [string]$result.FileContent
        Write-Log "Archived BitLocker key loaded for $computer from $($result.FilePath)." -Level Success
    }
    catch {
        Show-Error "Failed to retrieve archived BitLocker key for $computer.`r`n$($_.Exception.Message)"
    }
})

Update-PopupTargetCountLabel -RawComputerInput $txtPopupComputers.Text -FilePathInput $txtCompFilePath.Text.Trim() -TargetLabel $lblPopupTargetCount
Refresh-SettingsProfileDropdown
$activeProfile = Get-ActiveProfileName
if ($cmbSettingsProfile.Items.Contains($activeProfile)) {
    $cmbSettingsProfile.SelectedItem = $activeProfile
}
Apply-SettingsProfile -ProfileName $activeProfile

$script:settingsAutoSaveTimer = New-Object System.Windows.Forms.Timer
$script:settingsAutoSaveTimer.Interval = 15000
$script:settingsAutoSaveTimer.Add_Tick({
    try {
        Save-CurrentProfileSettings
    }
    catch {
        Write-Log "Autosave warning: $($_.Exception.Message)" -Level Warn
    }
})
$script:settingsAutoSaveTimer.Start()

$form.Add_FormClosing({
    try {
        if ($script:settingsAutoSaveTimer) {
            $script:settingsAutoSaveTimer.Stop()
        }
        if ($script:cookieTimer) {
            $script:cookieTimer.Stop()
        }
        Save-CurrentProfileSettings
    }
    catch {
        # Do not block app close for save failures.
    }
})

Write-Log "Joe's System Services launched for $($script:AdminCredential.UserName)." -Level Success
$tabs.SelectedTab = $tabWelcome

[void]$form.ShowDialog()
