function Get-CookieMilestoneThresholds {
    return @(3, 5, 10, 15)
}

function Get-CookieUnlockedUpgradeKeys {
    $keys = @()
    foreach ($upgrade in $script:CookieUpgrades.Values) {
        $required = if ($upgrade.PSObject.Properties.Name -contains 'UnlockPrestige') { [int]$upgrade.UnlockPrestige } else { 0 }
        if ($script:CookiePrestigeCount -ge $required) {
            $keys += $upgrade.Key
        }
    }
    return @($keys)
}

function Show-CookieEventBanner {
    param(
        [string]$Message,
        [System.Drawing.Color]$BackColor
    )
    if (-not $script:lblCookieEvent) { return }
    $script:lblCookieEvent.Text = $Message
    $script:lblCookieEvent.BackColor = $BackColor
    $script:lblCookieEvent.Visible = $true
    $script:cookieEventHideAt = (Get-Date).AddSeconds(3)
}

function Get-CookiePrestigeCost {
    $baseCost = 1000000.0
    return [Math]::Round($baseCost * [Math]::Pow(1.85, [double]$script:CookiePrestigeCount), 2)
}

function Get-CookieUpgradeCost {
    param([Parameter(Mandatory)] [string]$UpgradeKey)
    $upgrade = $script:CookieUpgrades[$UpgradeKey]
    if (-not $upgrade) { return 0.0 }
    $baseCost = [double]$upgrade.BaseCost * [Math]::Pow($upgrade.CostMultiplier, $upgrade.Level)
    $discountPerk = [int]$script:CookiePrestigePerkStacks['FrugalEngineering']
    $discountFactor = [Math]::Pow(0.92, $discountPerk)
    $economyDiscount = [Math]::Pow(0.95, [int]$script:CookieAscensionTree['Economy'])
    $discountFactor *= $economyDiscount
    if ($discountFactor -lt 0.30) { $discountFactor = 0.30 }
    return [Math]::Round(($baseCost * $discountFactor), 2)
}

function Recalculate-CookieRates {
    $script:CookiesPerClick = 1.0
    $script:CookiesPerSecond = 0.0
    $script:CookieCritChance = [Math]::Min(0.60, 0.03 * [int]$script:CookieAscensionTree['Luck'])
    $script:CookieCritMultiplier = 2.0 + (0.40 * [int]$script:CookieAscensionTree['Luck'])

    foreach ($upgrade in $script:CookieUpgrades.Values) {
        if ($upgrade.Level -le 0) { continue }
        $level = [int]$upgrade.Level
        $outputMultiplier = if ($upgrade.PSObject.Properties.Name -contains 'OutputMultiplier') { [double]$upgrade.OutputMultiplier } else { 1.0 }
        $totalOutput = 0.0

        if ($outputMultiplier -eq 1.0) {
            $totalOutput = [double]$upgrade.Gain * $level
        }
        else {
            $totalOutput = [double]$upgrade.Gain * (([Math]::Pow($outputMultiplier, $level) - 1.0) / ($outputMultiplier - 1.0))
        }

        if ($upgrade.Type -eq 'Click') {
            $script:CookiesPerClick += $totalOutput
        }
        else {
            $script:CookiesPerSecond += $totalOutput
        }
    }

    $clickPerkBoost = [Math]::Pow(1.25, [int]$script:CookiePrestigePerkStacks['ClickMastery'])
    $autoPerkBoost = [Math]::Pow(1.25, [int]$script:CookiePrestigePerkStacks['AutomationSurge'])
    $clickAscensionBoost = [Math]::Pow(1.07, [int]$script:CookieAscensionTree['Click'])
    $autoAscensionBoost = [Math]::Pow(1.13, [int]$script:CookieAscensionTree['Automation'])
    $luckCpsBoost = [Math]::Pow(1.03, [int]$script:CookieAscensionTree['Luck'])
    $script:CookiesPerClick = [Math]::Round(($script:CookiesPerClick * $clickPerkBoost), 4)
    $script:CookiesPerSecond = [Math]::Round(($script:CookiesPerSecond * $autoPerkBoost), 4)
    $script:CookiesPerClick = [Math]::Round(($script:CookiesPerClick * $clickAscensionBoost), 4)
    $script:CookiesPerSecond = [Math]::Round(($script:CookiesPerSecond * $autoAscensionBoost), 4)
    $script:CookiesPerSecond = [Math]::Round(($script:CookiesPerSecond * $luckCpsBoost), 4)
}

function Get-CookieUpgradeNextGain {
    param([Parameter(Mandatory)] [string]$UpgradeKey)
    $upgrade = $script:CookieUpgrades[$UpgradeKey]
    if (-not $upgrade) { return 0.0 }

    $level = [int]$upgrade.Level
    $outputMultiplier = if ($upgrade.PSObject.Properties.Name -contains 'OutputMultiplier') { [double]$upgrade.OutputMultiplier } else { 1.0 }
    return [double]$upgrade.Gain * [Math]::Pow($outputMultiplier, $level)
}

function Get-CookieClickerSaveState {
    if (-not $script:CookieUpgrades) { Initialize-CookieUpgrades }
    return [pscustomobject]@{
        CookieCount = [double]$script:CookieCount
        PrestigeCount = [int]$script:CookiePrestigeCount
        PrestigePerks = [pscustomobject]@{
            ClickMastery = [int]$script:CookiePrestigePerkStacks['ClickMastery']
            AutomationSurge = [int]$script:CookiePrestigePerkStacks['AutomationSurge']
            FrugalEngineering = [int]$script:CookiePrestigePerkStacks['FrugalEngineering']
        }
        Ascension = [pscustomobject]@{
            Points = [int]$script:CookieAscensionPoints
            Click = [int]$script:CookieAscensionTree['Click']
            Automation = [int]$script:CookieAscensionTree['Automation']
            Economy = [int]$script:CookieAscensionTree['Economy']
            Luck = [int]$script:CookieAscensionTree['Luck']
        }
        Upgrades = @($script:CookieUpgrades.Values | ForEach-Object {
            [pscustomobject]@{
                Key = $_.Key
                Level = [int]$_.Level
            }
        })
    }
}

function Import-CookieClickerSaveState {
    param($SavedState)

    if (-not $script:CookieUpgrades) { Initialize-CookieUpgrades }
    $script:CookiePrestigeCount = 0
    $script:CookiePrestigePerkStacks = @{ ClickMastery = 0; AutomationSurge = 0; FrugalEngineering = 0 }
    $script:CookieAscensionPoints = 0
    $script:CookieAscensionTree = @{ Click = 0; Automation = 0; Economy = 0; Luck = 0 }
    $script:CookieSeenMilestones = @{}
    $script:CookieCount = 0.0
    foreach ($upgrade in $script:CookieUpgrades.Values) {
        $upgrade.Level = 0
    }

    if ($SavedState) {
        if ($SavedState.PSObject.Properties.Name -contains 'CookieCount') {
            $script:CookieCount = [Math]::Max(0.0, [double]$SavedState.CookieCount)
        }

        if ($SavedState.PSObject.Properties.Name -contains 'PrestigeCount') {
            $script:CookiePrestigeCount = [Math]::Max(0, [int]$SavedState.PrestigeCount)
        }

        if ($SavedState.PSObject.Properties.Name -contains 'PrestigePerks' -and $SavedState.PrestigePerks) {
            foreach ($perkName in @('ClickMastery', 'AutomationSurge', 'FrugalEngineering')) {
                if ($SavedState.PrestigePerks.PSObject.Properties.Name -contains $perkName) {
                    $script:CookiePrestigePerkStacks[$perkName] = [Math]::Max(0, [int]$SavedState.PrestigePerks.$perkName)
                }
            }
        }
        if ($SavedState.PSObject.Properties.Name -contains 'Ascension' -and $SavedState.Ascension) {
            if ($SavedState.Ascension.PSObject.Properties.Name -contains 'Points') {
                $script:CookieAscensionPoints = [Math]::Max(0, [int]$SavedState.Ascension.Points)
            }
            foreach ($branch in @('Click', 'Automation', 'Economy', 'Luck')) {
                if ($SavedState.Ascension.PSObject.Properties.Name -contains $branch) {
                    $script:CookieAscensionTree[$branch] = [Math]::Max(0, [int]$SavedState.Ascension.$branch)
                }
            }
        }

        if ($SavedState.PSObject.Properties.Name -contains 'Upgrades' -and $SavedState.Upgrades) {
            foreach ($savedUpgrade in $SavedState.Upgrades) {
                $key = [string]$savedUpgrade.Key
                if ($script:CookieUpgrades.Contains($key)) {
                    $script:CookieUpgrades[$key].Level = [Math]::Max(0, [int]$savedUpgrade.Level)
                }
            }
        }

    }

    Recalculate-CookieRates
    foreach ($threshold in (Get-CookieMilestoneThresholds)) {
        if ($script:CookiePrestigeCount -ge $threshold) {
            $script:CookieSeenMilestones["M$threshold"] = $true
        }
    }
    Update-CookieClickerUi
}

function Update-CookieClickerUi {
    if (-not $script:lblCookieCount) { return }

    $script:lblCookieCount.Text = "Cookies: $(Format-CookieNumber -Value $script:CookieCount)"
    $script:lblCookieStats.Text = "CPc: $(Format-CookieNumber -Value $script:CookiesPerClick)   |   CPS: $(Format-CookieNumber -Value $script:CookiesPerSecond)"
    if ($script:lblPrestigeInfo) {
        $cost = Get-CookiePrestigeCost
        $script:lblPrestigeInfo.Text = "Prestiges: $($script:CookiePrestigeCount)  |  Next Cost: $(Format-CookieNumber -Value $cost)"
    }
    if ($script:lblPrestigePerks) {
        $script:lblPrestigePerks.Text = "Perks - Click Mastery: $($script:CookiePrestigePerkStacks['ClickMastery'])  |  Automation Surge: $($script:CookiePrestigePerkStacks['AutomationSurge'])  |  Frugal Engineering: $($script:CookiePrestigePerkStacks['FrugalEngineering'])"
    }
    if ($script:lblPrestigeMultipliers) {
        $clickMult = [Math]::Pow(1.25, [int]$script:CookiePrestigePerkStacks['ClickMastery'])
        $autoMult = [Math]::Pow(1.25, [int]$script:CookiePrestigePerkStacks['AutomationSurge'])
        $costMult = [Math]::Pow(0.92, [int]$script:CookiePrestigePerkStacks['FrugalEngineering'])
        if ($costMult -lt 0.35) { $costMult = 0.35 }
        $script:lblPrestigeMultipliers.Text = "xCPc $([Math]::Round($clickMult, 2))  xCPS $([Math]::Round($autoMult, 2))  xCost $([Math]::Round($costMult, 2))"
    }
    if ($script:lblAscensionInfo) {
        $spent = [int]$script:CookieAscensionTree['Click'] + [int]$script:CookieAscensionTree['Automation'] + [int]$script:CookieAscensionTree['Economy'] + [int]$script:CookieAscensionTree['Luck']
        $available = [Math]::Max(0, [int]$script:CookieAscensionPoints - $spent)
        $script:lblAscensionInfo.Text = "Ascension Points: $available (Total $($script:CookieAscensionPoints))"
    }
    if ($script:lblAscensionHint) {
        $clickLevel = [int]$script:CookieAscensionTree['Click']
        $autoLevel = [int]$script:CookieAscensionTree['Automation']
        $economyLevel = [int]$script:CookieAscensionTree['Economy']
        $luckLevel = [int]$script:CookieAscensionTree['Luck']

        $clickBoostPct = [Math]::Round((([Math]::Pow(1.07, $clickLevel) - 1.0) * 100.0), 1)
        $autoBoostPct = [Math]::Round((([Math]::Pow(1.13, $autoLevel) - 1.0) * 100.0), 1)
        $economyCostPct = [Math]::Round((100.0 - ([Math]::Pow(0.95, $economyLevel) * 100.0)), 1)
        $luckCritChance = [Math]::Round((3.0 * $luckLevel), 1)
        $luckCritPower = [Math]::Round((0.40 * $luckLevel), 2)
        $luckCpsPct = [Math]::Round((([Math]::Pow(1.03, $luckLevel) - 1.0) * 100.0), 1)

        $script:lblAscensionHint.Text = "Ascension Effects: CPc +$clickBoostPct% | CPS +$autoBoostPct% | Costs -$economyCostPct% | Luck: Crit +$luckCritChance%, +$luckCritPower power, CPS +$luckCpsPct%"
    }
    if ($script:btnAscClick) { $script:btnAscClick.Text = "Click Path (Level $($script:CookieAscensionTree['Click']))" }
    if ($script:btnAscAuto) { $script:btnAscAuto.Text = "Automation (Level $($script:CookieAscensionTree['Automation']))" }
    if ($script:btnAscEconomy) { $script:btnAscEconomy.Text = "Economy (Level $($script:CookieAscensionTree['Economy']))" }
    if ($script:btnAscLuck) { $script:btnAscLuck.Text = "Luck (Level $($script:CookieAscensionTree['Luck']))" }
    if ($script:lblCritInfo) {
        $script:lblCritInfo.Text = "Crits: $([Math]::Round($script:CookieCritChance * 100, 1))% chance, x$([Math]::Round($script:CookieCritMultiplier, 2)) power"
    }
    if ($script:lblMilestoneInfo) {
        $next = (Get-CookieMilestoneThresholds | Where-Object { $_ -gt $script:CookiePrestigeCount } | Select-Object -First 1)
        if ($next) {
            $script:lblMilestoneInfo.Text = "Next Unlock Milestone: P$next"
        }
        else {
            $script:lblMilestoneInfo.Text = "All milestone unlocks achieved."
        }
    }
    if ($script:btnPrestige) {
        $script:btnPrestige.Enabled = ($script:CookieCount -ge (Get-CookiePrestigeCost))
    }

    $visibleIndex = 0
    $unlockedUpgradeKeys = Get-CookieUnlockedUpgradeKeys
    foreach ($upgrade in $script:CookieUpgrades.Values) {
        if (-not $script:CookieUpgradeButtons.Contains($upgrade.Key)) { continue }
        $btn = $script:CookieUpgradeButtons[$upgrade.Key]
        $btn.Visible = $true
        $col = $visibleIndex % [int]$script:CookieShopCols
        $row = [int][Math]::Floor($visibleIndex / [int]$script:CookieShopCols)
        $btn.Location = New-Object System.Drawing.Point(($col * ($script:CookieShopBtnWidth + $script:CookieShopColGap)), ($row * ($script:CookieShopBtnHeight + $script:CookieShopRowGap)))
        $visibleIndex++

        $gainUnit = if ($upgrade.Type -eq 'Click') { 'CPc' } else { 'CPS' }
        $isUnlocked = ($unlockedUpgradeKeys -contains $upgrade.Key)
        if (-not $isUnlocked) {
            $requiredPrestige = if ($upgrade.PSObject.Properties.Name -contains 'UnlockPrestige') { [int]$upgrade.UnlockPrestige } else { 0 }
            $btn.Text = "$($upgrade.Name)  [$gainUnit LOCKED]`r`nUnlocks at Prestige $requiredPrestige"
            $btn.BackColor = [System.Drawing.Color]::FromArgb(78, 74, 95)
            $btn.ForeColor = [System.Drawing.Color]::FromArgb(220, 220, 230)
            continue
        }

        $cost = Get-CookieUpgradeCost -UpgradeKey $upgrade.Key
        $nextGain = Get-CookieUpgradeNextGain -UpgradeKey $upgrade.Key
        $btn.Text = "$($upgrade.Name)  Level $($upgrade.Level)`r`n+$(Format-CookieNumber -Value $nextGain) $gainUnit  |  Cost $(Format-CookieNumber -Value $cost)"
        $affordable = ($script:CookieCount -ge $cost)
        $btn.BackColor = if ($affordable) { [System.Drawing.Color]::FromArgb(228, 171, 89) } else { [System.Drawing.Color]::FromArgb(117, 93, 183) }
        $btn.ForeColor = if ($affordable) { [System.Drawing.Color]::FromArgb(35, 24, 20) } else { [System.Drawing.Color]::FromArgb(244, 240, 255) }
    }
}

function Invoke-CookiePurchase {
    param(
        [Parameter(Mandatory)] [string]$UpgradeKey
    )

    if (-not $script:CookieUpgrades.Contains($UpgradeKey)) { return $false }
    $cost = Get-CookieUpgradeCost -UpgradeKey $UpgradeKey
    if ($script:CookieCount -lt $cost) { return $false }

    $script:CookieCount -= $cost
    $script:CookieUpgrades[$UpgradeKey].Level++
    Recalculate-CookieRates
    Update-CookieClickerUi
    return $true
}

function Get-CookieAscensionAvailablePoints {
    $spent = [int]$script:CookieAscensionTree['Click'] + [int]$script:CookieAscensionTree['Automation'] + [int]$script:CookieAscensionTree['Economy'] + [int]$script:CookieAscensionTree['Luck']
    return [Math]::Max(0, [int]$script:CookieAscensionPoints - $spent)
}

function Get-CookieAscensionBranchDescription {
    param([Parameter(Mandatory)] [ValidateSet('Click', 'Automation', 'Economy', 'Luck')] [string]$Branch)
    switch ($Branch) {
        'Click' { return '+7% total CPc per level' }
        'Automation' { return '+13% total CPS per level' }
        'Economy' { return '-5% upgrade costs per level (stacks)' }
        'Luck' { return '+3% crit chance, +0.40 crit power, and +3% CPS per level' }
    }
}

function Invoke-CookieAscensionBuy {
    param([Parameter(Mandatory)] [ValidateSet('Click', 'Automation', 'Economy', 'Luck')] [string]$Branch)
    if ((Get-CookieAscensionAvailablePoints) -le 0) {
        Show-Info 'No ascension points available.'
        return $false
    }
    $script:CookieAscensionTree[$Branch] = [int]$script:CookieAscensionTree[$Branch] + 1
    Recalculate-CookieRates
    Update-CookieClickerUi
    Save-CurrentProfileSettings
    Write-Log "Ascension node upgraded: $Branch (level $($script:CookieAscensionTree[$Branch]))."
    return $true
}

function Invoke-CookieMilestoneCheck {
    foreach ($threshold in (Get-CookieMilestoneThresholds)) {
        $token = "M$threshold"
        if (($script:CookiePrestigeCount -ge $threshold) -and (-not $script:CookieSeenMilestones.ContainsKey($token))) {
            $script:CookieSeenMilestones[$token] = $true
            Show-CookieEventBanner -Message "Milestone reached: Prestige $threshold unlocked new content!" -BackColor ([System.Drawing.Color]::FromArgb(83, 159, 110))
            Write-Log "Milestone unlocked at prestige $threshold." -Level Success
        }
    }
}

function Reset-CookieRunState {
    $script:CookieCount = 0.0
    foreach ($upgradeKey in @($script:CookieUpgrades.Keys)) {
        $script:CookieUpgrades[$upgradeKey].Level = 0
    }
    Recalculate-CookieRates
}

function Reset-CookieAllProgress {
    $script:CookiePrestigeCount = 0
    $script:CookiePrestigePerkStacks = @{ ClickMastery = 0; AutomationSurge = 0; FrugalEngineering = 0 }
    Reset-CookieRunState
}

function Invoke-CookieSaveNow {
    try {
        Save-CurrentProfileSettings
        Write-Log "Cookie Clicker progress saved for profile '$(Get-SelectedSettingsProfileName)'." -Level Success
        return $true
    }
    catch {
        Write-Log "Cookie Clicker save failed: $($_.Exception.Message)" -Level Error
        Show-Error "Save failed.`r`n$($_.Exception.Message)"
        return $false
    }
}

function Show-CookiePrestigePerkPicker {
    $picker = New-Object System.Windows.Forms.Form
    $picker.Text = 'Choose Your Prestige Perk'
    $picker.Size = New-Object System.Drawing.Size(560, 300)
    $picker.StartPosition = 'CenterParent'
    $picker.FormBorderStyle = 'FixedDialog'
    $picker.MaximizeBox = $false
    $picker.MinimizeBox = $false
    $picker.BackColor = [System.Drawing.Color]::FromArgb(28, 24, 46)

    $lblTitle = New-Object System.Windows.Forms.Label
    $lblTitle.Text = 'Pick 1 of 3 perks (stacks every prestige):'
    $lblTitle.Font = New-Object System.Drawing.Font('Segoe UI Semibold', 12)
    $lblTitle.ForeColor = [System.Drawing.Color]::White
    $lblTitle.AutoSize = $true
    $lblTitle.Location = New-Object System.Drawing.Point(16, 14)
    $picker.Controls.Add($lblTitle)

    $choices = @(
        @{ Key = 'ClickMastery'; Label = 'Click Mastery'; Desc = '+25% total CPc each stack' }
        @{ Key = 'AutomationSurge'; Label = 'Automation Surge'; Desc = '+25% total CPS each stack' }
        @{ Key = 'FrugalEngineering'; Label = 'Frugal Engineering'; Desc = '-8% upgrade costs each stack (cap 65% off)' }
    )

    for ($i = 0; $i -lt $choices.Count; $i++) {
        $choice = $choices[$i]
        $btn = New-Object System.Windows.Forms.Button
        $btn.Size = New-Object System.Drawing.Size(165, 140)
        $btn.Location = New-Object System.Drawing.Point((16 + ($i * 178)), 60)
        $btn.FlatStyle = 'Flat'
        $btn.BackColor = [System.Drawing.Color]::FromArgb(93, 76, 152)
        $btn.ForeColor = [System.Drawing.Color]::White
        $btn.Font = New-Object System.Drawing.Font('Segoe UI Semibold', 9.5)
        $btn.Text = "$($choice.Label)`r`n`r`n$($choice.Desc)"
        $btn.Tag = $choice.Key
        $btn.Add_Click({
            $picker.Tag = [string]$this.Tag
            $picker.DialogResult = [System.Windows.Forms.DialogResult]::OK
            $picker.Close()
        })
        $picker.Controls.Add($btn)
    }

    $cancel = New-Object System.Windows.Forms.Button
    $cancel.Text = 'Cancel'
    $cancel.Size = New-Object System.Drawing.Size(90, 30)
    $cancel.Location = New-Object System.Drawing.Point(446, 214)
    $cancel.FlatStyle = 'Flat'
    $cancel.BackColor = [System.Drawing.Color]::FromArgb(60, 60, 70)
    $cancel.ForeColor = [System.Drawing.Color]::White
    $cancel.Add_Click({
        $picker.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
        $picker.Close()
    })
    $picker.Controls.Add($cancel)

    $result = $picker.ShowDialog()
    if ($result -ne [System.Windows.Forms.DialogResult]::OK) { return $null }
    return [string]$picker.Tag
}

function Invoke-CookiePrestige {
    $cost = Get-CookiePrestigeCost
    if ($script:CookieCount -lt $cost) {
        Show-Info "Need $(Format-CookieNumber -Value $cost) cookies to prestige."
        return $false
    }

    $confirm = Show-YesNo "Prestige now for 1 perk pick?`r`nThis resets cookies and all upgrade levels."
    if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) {
        return $false
    }

    $selectedPerk = Show-CookiePrestigePerkPicker
    if ([string]::IsNullOrWhiteSpace($selectedPerk)) {
        Write-Log 'Prestige canceled before perk selection.' -Level Warn
        return $false
    }

    try {
        $beforeCookies = [double]$script:CookieCount
        $script:CookiePrestigeCount++
        $script:CookieAscensionPoints++
        $script:CookiePrestigePerkStacks[$selectedPerk] = [int]$script:CookiePrestigePerkStacks[$selectedPerk] + 1
        Reset-CookieRunState
        Invoke-CookieMilestoneCheck
        Show-CookieEventBanner -Message "Prestige complete! +1 Ascension Point earned." -BackColor ([System.Drawing.Color]::FromArgb(170, 76, 139))
        Update-CookieClickerUi
        Save-CurrentProfileSettings
        Write-Log "Prestige complete. Cost gate met at $(Format-CookieNumber -Value $cost), cookies before reset: $(Format-CookieNumber -Value $beforeCookies). Perk: $selectedPerk. Total prestiges: $($script:CookiePrestigeCount)." -Level Success
        Show-Info 'Prestige complete. Cookies and upgrade levels were reset, and your perk stack was applied.'
        return $true
    }
    catch {
        Write-Log "Prestige failed: $($_.Exception.Message)" -Level Error
        Show-Error "Prestige failed.`r`n$($_.Exception.Message)"
        return $false
    }
}

function Invoke-CookieStartOver {
    $confirm = Show-YesNo "Completely start over Cookie Clicker?`r`nThis will wipe cookies, upgrades, prestiges, and perk stacks."
    if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) { return $false }

    $confirmAgain = Show-YesNo "Final confirmation: this cannot be undone. Reset everything now?"
    if ($confirmAgain -ne [System.Windows.Forms.DialogResult]::Yes) { return $false }

    try {
        Reset-CookieAllProgress
        $script:CookieSeenMilestones = @{}
        Update-CookieClickerUi
        Save-CurrentProfileSettings
        Write-Log "Cookie Clicker progress fully reset by user request." -Level Warn
        Show-Info 'Cookie Clicker progress was fully reset.'
        return $true
    }
    catch {
        Write-Log "Start over failed: $($_.Exception.Message)" -Level Error
        Show-Error "Start over failed.`r`n$($_.Exception.Message)"
        return $false
    }
}

