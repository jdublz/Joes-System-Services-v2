    $script:tabSecret.Controls.Add($script:lblCritInfo)

    $script:btnCookieClick.Add_Click({
        $clickValue = [double]$script:CookiesPerClick
        if ((Get-Random -Minimum 0.0 -Maximum 1.0) -lt $script:CookieCritChance) {
            $clickValue *= $script:CookieCritMultiplier
            Show-CookieEventBanner -Message "CRIT CLICK! +$(Format-CookieNumber -Value $clickValue)" -BackColor ([System.Drawing.Color]::FromArgb(177, 121, 68))
        }
        $script:CookieCount += $clickValue
        Update-CookieClickerUi
    })

    $script:btnPrestige.Add_Click({
        [void](Invoke-CookiePrestige)
    })

    $script:btnCookieSaveNow.Add_Click({
        [void](Invoke-CookieSaveNow)
    })

    $script:btnCookieStartOver.Add_Click({
        [void](Invoke-CookieStartOver)
    })

    $script:btnAscClick.Add_Click({ [void](Invoke-CookieAscensionBuy -Branch Click) })
    $script:btnAscAuto.Add_Click({ [void](Invoke-CookieAscensionBuy -Branch Automation) })
    $script:btnAscEconomy.Add_Click({ [void](Invoke-CookieAscensionBuy -Branch Economy) })
    $script:btnAscLuck.Add_Click({ [void](Invoke-CookieAscensionBuy -Branch Luck) })

    $script:cookieTimer = New-Object System.Windows.Forms.Timer
    $script:cookieTimer.Interval = 250
    $script:cookieTimer.Add_Tick({
        if ($script:CookiesPerSecond -gt 0) {
            $script:CookieCount += ($script:CookiesPerSecond / 4.0)
            Update-CookieClickerUi
        }
        if ($script:lblCookieEvent -and $script:lblCookieEvent.Visible -and $script:cookieEventHideAt -and ((Get-Date) -ge $script:cookieEventHideAt)) {
            $script:lblCookieEvent.Visible = $false
        }
    })
    $script:cookieTimer.Start()

    Update-CookieClickerUi
    [void]$TabControl.TabPages.Add($script:tabSecret)
    $script:SecretTabCreated = $true
    return $script:tabSecret
}

# -----------------------------
# Credential prompt first
# -----------------------------
try {
    $script:AdminCredential = Get-Credential -Message 'Enter the admin credentials to use for Joe''s System Services.'
    if (-not $script:AdminCredential) {
        throw 'No credentials were provided. Exiting.'
    }
}
catch {
    [System.Windows.Forms.MessageBox]::Show('Joe''s System Services cannot start without credentials.', 'Joe''s System Services', 'OK', 'Error') | Out-Null
    return
}

