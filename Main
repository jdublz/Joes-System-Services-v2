# -----------------------------
# Shared event helpers
# -----------------------------
function Invoke-PingButton {
    param([string]$ComputerName)

    if ([string]::IsNullOrWhiteSpace($ComputerName)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    Write-Log "Pinging $ComputerName..."
    if (Test-HostPing -ComputerName $ComputerName) {
        Show-Info "$ComputerName responded to ping."
        Write-Log "$ComputerName responded to ping." -Level Success
    }
    else {
        Show-Error "$ComputerName did not respond to ping."
        Write-Log "$ComputerName did not respond to ping." -Level Error
    }
}

function Invoke-GeneralAction {
    param(
        [string]$ComputerName,
        [string]$Action,
        [System.Windows.Forms.TextBox]$OutputBox
    )

    if ([string]::IsNullOrWhiteSpace($ComputerName)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    try {
        Write-Log "Running $Action on $ComputerName..."
        if (-not (Test-RemoteAccess -ComputerName $ComputerName -Credential $script:AdminCredential)) {
            return
        }

        $result = Invoke-GeneralRemoteCommand -ComputerName $ComputerName -Credential $script:AdminCredential -Action $Action
        $OutputBox.Text = [string]$result
        Write-Log "$Action completed on $ComputerName." -Level Success
    }
    catch {
        Show-Error "$Action failed for $ComputerName.`r`n$($_.Exception.Message)"
    }
}

function Invoke-GeneralWindowsUpdateAction {
    param(
        [Parameter(Mandatory)] [ValidateSet('Check','Install')] [string]$Mode,
        [Parameter(Mandatory)] [System.Windows.Forms.TextBox]$OutputBox
    )

    $inputValue = $txtGComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($inputValue)) {
        Show-Error "Enter a computer name, comma-separated computer names, or a .txt file path."
        return
    }

    $raw = $inputValue
    $file = ''
    if (($inputValue -like '*.txt') -and (Test-Path -Path $inputValue)) {
        $raw = ''
        $file = $inputValue
    }

    try {
        $targets = Get-ComputerTargetsFromInput -RawComputerInput $raw -FilePathInput $file
    }
    catch {
        Show-Error $_.Exception.Message
        return
    }

    if (-not $targets -or $targets.Count -eq 0) {
        Show-Error "No valid targets were found in the Computer Name field."
        return
    }

    if ($Mode -eq 'Install') {
        $confirm = Show-YesNo "Install pending Windows updates on $($targets.Count) computer(s)?"
        if ($confirm -ne [System.Windows.Forms.DialogResult]::Yes) {
            Write-Log 'Windows update install canceled by user.' -Level Warn
            return
        }
    }

    $actionLabel = if ($Mode -eq 'Check') { 'check' } else { 'install' }
    $OutputBox.Clear()
    $OutputBox.AppendText("Windows Update $actionLabel run started: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')`r`n")
    $OutputBox.AppendText("Targets: $($targets -join ', ')`r`n`r`n")
    Write-Log "Starting Windows Update $actionLabel on $($targets.Count) target(s)..."

    $success = 0
    $fail = 0
    $rebootNeeded = 0

    foreach ($computer in $targets) {
        $OutputBox.AppendText("[$computer] --------------------------------`r`n")
        try {
            if (-not (Test-HostPing -ComputerName $computer)) {
                $OutputBox.AppendText("Ping failed. Skipping.`r`n`r`n")
                Write-Log "Windows Update $actionLabel skipped for $computer (ping failed)." -Level Error
                $fail++
                continue
            }

            if (-not (Test-RemoteAccess -ComputerName $computer -Credential $script:AdminCredential)) {
                $OutputBox.AppendText("Remote access failed. Skipping.`r`n`r`n")
                $fail++
                continue
            }

            Write-Log "Running Windows Update $actionLabel on $computer..."
            $result = Invoke-RemoteWindowsUpdate -ComputerName $computer -Credential $script:AdminCredential -Mode $Mode
            $resultCodeMeaning = Get-WindowsUpdateResultCodeMeaning -ResultCode $result.ResultCode

            $OutputBox.AppendText("Pending updates found: $($result.PendingCount)`r`n")
            if ($Mode -eq 'Install') {
                $OutputBox.AppendText("Installed updates: $($result.InstalledCount)`r`n")
            }
            $OutputBox.AppendText("Result code: $($result.ResultCode) = $resultCodeMeaning`r`n")
            $OutputBox.AppendText("Reboot required: $($result.RebootRequired)`r`n")

            if ($result.UpdateTitles -and $result.UpdateTitles.Count -gt 0) {
                $OutputBox.AppendText("Updates:`r`n")
                foreach ($title in $result.UpdateTitles) {
                    $OutputBox.AppendText(" - $title`r`n")
                }
            }
            else {
                $OutputBox.AppendText("Updates: none detected.`r`n")
            }
            $OutputBox.AppendText("`r`n")

            if ([bool]$result.RebootRequired) { $rebootNeeded++ }
            Write-Log "Windows Update $actionLabel completed on $computer. Pending: $($result.PendingCount), RebootRequired: $($result.RebootRequired)" -Level Success
            $success++
        }
        catch {
            $OutputBox.AppendText("$actionLabel failed: $($_.Exception.Message)`r`n`r`n")
            Write-Log "Windows Update $actionLabel failed on ${computer}: $($_.Exception.Message)" -Level Error
            $fail++
        }
    }

    $summary = "Windows Update $actionLabel complete. Success: $success, Failed: $fail, Reboot required: $rebootNeeded"
    $OutputBox.AppendText($summary + "`r`n")
    Write-Log $summary
    Show-Info $summary
}

function Update-PopupTargetCountLabel {
    param(
        [string]$RawComputerInput,
        [string]$FilePathInput,
        [System.Windows.Forms.Label]$TargetLabel
    )

    if (-not $TargetLabel) { return }

    try {
        $targets = Get-ComputerTargetsFromInput -RawComputerInput $RawComputerInput -FilePathInput $FilePathInput
        $TargetLabel.Text = "Targets detected: $($targets.Count)"
        $TargetLabel.ForeColor = [System.Drawing.Color]::FromArgb(70, 70, 70)
    }
    catch {
        $TargetLabel.Text = 'Targets detected: invalid file path'
        $TargetLabel.ForeColor = [System.Drawing.Color]::FromArgb(175, 75, 75)
    }
}

function Update-ThemePreview {
    $pnlHeaderPreview.BackColor = $script:HeaderColor
    $pnlAccentPreview.BackColor = $script:AccentColor
    $pnlThemePreviewHeader.BackColor = $script:HeaderColor
    $btnThemePreviewPrimary.BackColor = $script:AccentColor
    $btnThemePreviewSecondary.BackColor = $script:AccentColor
    $lblHeaderRgb.Text = "RGB: $($script:HeaderColor.R),$($script:HeaderColor.G),$($script:HeaderColor.B)"
    $lblAccentRgb.Text = "RGB: $($script:AccentColor.R),$($script:AccentColor.G),$($script:AccentColor.B)"
}

function Set-VisualModeForControl {
    param([System.Windows.Forms.Control]$Control)

    if (-not $Control) { return }
    if ($script:tabSecret -and ($Control -eq $script:tabSecret -or $script:tabSecret.Contains($Control))) { return }

    $darkBack = [System.Drawing.Color]::FromArgb(34, 38, 46)
    $darkSurface = [System.Drawing.Color]::FromArgb(45, 50, 60)
    $darkInput = [System.Drawing.Color]::FromArgb(27, 31, 38)
    $darkFore = [System.Drawing.Color]::FromArgb(235, 239, 246)
    $lightBack = [System.Drawing.Color]::White
    $lightInput = [System.Drawing.Color]::FromArgb(246, 248, 250)
    $lightFore = [System.Drawing.Color]::Black

    if ($Control -is [System.Windows.Forms.TabControl] -or $Control -is [System.Windows.Forms.Button]) {
        return
    }

    if ($Control -is [System.Windows.Forms.TextBox]) {
        $Control.BackColor = if ($script:IsDarkMode) { $darkInput } else { $lightInput }
        $Control.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
    }
    elseif ($Control -is [System.Windows.Forms.ComboBox] -or $Control -is [System.Windows.Forms.ListBox]) {
        $Control.BackColor = if ($script:IsDarkMode) { $darkInput } else { [System.Drawing.Color]::White }
        $Control.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
    }
    elseif ($Control -is [System.Windows.Forms.DataGridView]) {
        $Control.BackgroundColor = if ($script:IsDarkMode) { $darkSurface } else { [System.Drawing.Color]::White }
        $Control.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
        $Control.DefaultCellStyle.BackColor = if ($script:IsDarkMode) { [System.Drawing.Color]::FromArgb(40, 45, 54) } else { [System.Drawing.Color]::White }
        $Control.DefaultCellStyle.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
        $Control.ColumnHeadersDefaultCellStyle.BackColor = if ($script:IsDarkMode) { [System.Drawing.Color]::FromArgb(58, 64, 76) } else { [System.Drawing.Color]::FromArgb(240, 240, 240) }
        $Control.ColumnHeadersDefaultCellStyle.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
        $Control.EnableHeadersVisualStyles = $false
    }
    else {
        if ($Control -is [System.Windows.Forms.TabPage]) {
            $Control.BackColor = if ($script:IsDarkMode) { $darkBack } else { $lightBack }
        }
        elseif ($Control -is [System.Windows.Forms.GroupBox] -or $Control -is [System.Windows.Forms.Panel]) {
            $Control.BackColor = if ($script:IsDarkMode) { $darkSurface } else { $lightBack }
        }
        elseif (-not ($Control -eq $form -or $Control -eq $headerPanel)) {
            $Control.BackColor = if ($script:IsDarkMode) { $darkBack } else { $lightBack }
        }

        if ($Control -is [System.Windows.Forms.Label] -or $Control -is [System.Windows.Forms.GroupBox]) {
            $Control.ForeColor = if ($script:IsDarkMode) { $darkFore } else { $lightFore }
        }
    }

    foreach ($child in $Control.Controls) {
        Set-VisualModeForControl -Control $child
    }
}

function Get-ReadableTextColor {
    param([System.Drawing.Color]$BackgroundColor)
    $luma = (0.299 * $BackgroundColor.R) + (0.587 * $BackgroundColor.G) + (0.114 * $BackgroundColor.B)
    if ($luma -lt 145) {
        return [System.Drawing.Color]::White
    }
    return [System.Drawing.Color]::FromArgb(25, 25, 25)
}

function Refresh-TabOrderList {
    $lstTabOrder.Items.Clear()
    foreach ($page in $tabs.TabPages) {
        [void]$lstTabOrder.Items.Add($page.Text)
    }
}

function Apply-TabOrderFromList {
    $orderedNames = @($lstTabOrder.Items | ForEach-Object { [string]$_ })
    if (-not $orderedNames -or $orderedNames.Count -eq 0) { return }

    $lookup = @{}
    foreach ($page in $tabs.TabPages) {
        $lookup[$page.Text] = $page
    }

    $tabs.TabPages.Clear()
    foreach ($name in $orderedNames) {
        if ($lookup.ContainsKey($name)) {
            [void]$tabs.TabPages.Add($lookup[$name])
        }
    }
}

function Apply-SavedTabOrder {
    param($SavedTabOrder)

    if (-not $SavedTabOrder) { return }
    $orderedNames = @($SavedTabOrder | ForEach-Object { [string]$_ })
    if ($orderedNames.Count -eq 0) { return }

    $lookup = @{}
    foreach ($page in $tabs.TabPages) {
        $lookup[$page.Text] = $page
    }

    $tabs.TabPages.Clear()
    foreach ($name in $orderedNames) {
        if ($lookup.ContainsKey($name)) {
            [void]$tabs.TabPages.Add($lookup[$name])
            $null = $lookup.Remove($name)
        }
    }

    foreach ($remaining in $lookup.Values) {
        [void]$tabs.TabPages.Add($remaining)
    }
}

function Refresh-SettingsProfileDropdown {
    $current = if ($cmbSettingsProfile.SelectedItem) { [string]$cmbSettingsProfile.SelectedItem } else { '' }
    $names = Get-ProfileNames
    $cmbSettingsProfile.Items.Clear()
    foreach ($name in $names) {
        [void]$cmbSettingsProfile.Items.Add($name)
    }

    if ($current -and $cmbSettingsProfile.Items.Contains($current)) {
        $cmbSettingsProfile.SelectedItem = $current
    }
    elseif ($cmbSettingsProfile.Items.Contains('Default')) {
        $cmbSettingsProfile.SelectedItem = 'Default'
    }
    elseif ($cmbSettingsProfile.Items.Count -gt 0) {
        $cmbSettingsProfile.SelectedIndex = 0
    }
}

function Get-SelectedSettingsProfileName {
    if ($cmbSettingsProfile -and $cmbSettingsProfile.SelectedItem) {
        return [string]$cmbSettingsProfile.SelectedItem
    }
    return 'Default'
}

function Save-CurrentProfileSettings {
    if (-not $tabs) { return }
    $profileName = Get-SelectedSettingsProfileName
    Save-UserSettings -TabControl $tabs -ProfileName $profileName
}

function Apply-SettingsProfile {
    param([string]$ProfileName)

    $script:IsApplyingSettingsProfile = $true
    $safeProfile = Get-SafeProfileName -ProfileName $ProfileName
    $script:HeaderColor = $script:DefaultHeaderColor
    $script:AccentColor = $script:DefaultAccentColor
    $script:IsDarkMode = $false

    $settings = Get-UserSettings -ProfileName $safeProfile
    if ($settings) {
        try {
            if ($settings.HeaderColor) {
                $script:HeaderColor = [System.Drawing.Color]::FromArgb(
                    [int]$settings.HeaderColor.R,
                    [int]$settings.HeaderColor.G,
                    [int]$settings.HeaderColor.B
                )
            }
            if ($settings.AccentColor) {
                $script:AccentColor = [System.Drawing.Color]::FromArgb(
                    [int]$settings.AccentColor.R,
                    [int]$settings.AccentColor.G,
                    [int]$settings.AccentColor.B
                )
            }
            if ($settings.PSObject.Properties.Name -contains 'DarkMode') {
                $script:IsDarkMode = [bool]$settings.DarkMode
            }
            if ($settings.TabOrder) {
                Apply-SavedTabOrder -SavedTabOrder $settings.TabOrder
            }
            Import-CookieClickerSaveState -SavedState $settings.CookieClicker
        }
        catch {
            Write-Log "Unable to apply profile $safeProfile. Using defaults. $($_.Exception.Message)" -Level Warn
        }
    }
    else {
        Import-CookieClickerSaveState -SavedState $null
    }

    Set-ActiveProfileName -ProfileName $safeProfile
    if ($chkDarkMode) {
        $chkDarkMode.Checked = $script:IsDarkMode
    }
    Update-ThemePreview
    Apply-AppTheme
    Refresh-TabOrderList
    $script:IsApplyingSettingsProfile = $false
}

function Apply-AppTheme {
    $headerPanel.BackColor = $script:HeaderColor
    $form.BackColor = if ($script:IsDarkMode) { [System.Drawing.Color]::FromArgb(28, 32, 40) } else { [System.Drawing.Color]::FromArgb(236, 245, 244) }

    foreach ($page in $tabs.TabPages) {
        if ($script:tabSecret -and $page -eq $script:tabSecret) { continue }
        Set-VisualModeForControl -Control $page
    }

    if ($grpLog) {
        Set-VisualModeForControl -Control $grpLog
    }

    $accentButtons = @(
        $btnSPing, $btnSLoad, $btnBrowseCompFile, $btnSendPopup,
        $btnGPing, $btnGPUpdate, $btnIPConfig, $btnFlushDNS, $btnReleaseRenew,
        $btnDeletePing, $btnLoadProfiles, $btnDeleteProfiles,
        $btnBLPing, $btnEnableBL, $btnBLLookup, $btnCreateAccount,
        $btnSearchADUsers, $btnUseSelectedADUser,
        $btnPickHeaderColor, $btnPickAccentColor, $btnApplyTheme
    ) | Where-Object { $_ }

    foreach ($button in $accentButtons) {
        $button.BackColor = $script:AccentColor
        $button.ForeColor = Get-ReadableTextColor -BackgroundColor $script:AccentColor
    }

    # Keep Windows Update actions visually distinct from general network actions.
    if ($btnGWindowsUpdateCheck) {
        $btnGWindowsUpdateCheck.BackColor = [System.Drawing.Color]::FromArgb(245, 223, 168)
        $btnGWindowsUpdateCheck.ForeColor = Get-ReadableTextColor -BackgroundColor $btnGWindowsUpdateCheck.BackColor
    }
    if ($btnGWindowsUpdate) {
        $btnGWindowsUpdate.BackColor = [System.Drawing.Color]::FromArgb(176, 215, 207)
        $btnGWindowsUpdate.ForeColor = Get-ReadableTextColor -BackgroundColor $btnGWindowsUpdate.BackColor
    }
    if ($btnShutdown) {
        $btnShutdown.ForeColor = Get-ReadableTextColor -BackgroundColor $btnShutdown.BackColor
    }
    if ($btnDeleteProfiles) {
        $btnDeleteProfiles.ForeColor = Get-ReadableTextColor -BackgroundColor $btnDeleteProfiles.BackColor
    }
    if ($btnDeleteAccount) {
        $btnDeleteAccount.ForeColor = Get-ReadableTextColor -BackgroundColor $btnDeleteAccount.BackColor
    }
    if ($btnBLReboot) {
        $btnBLReboot.ForeColor = Get-ReadableTextColor -BackgroundColor $btnBLReboot.BackColor
    }
    if ($btnResetTheme) {
        $btnResetTheme.ForeColor = Get-ReadableTextColor -BackgroundColor $btnResetTheme.BackColor
    }
    if ($btnSaveAsProfile) {
        $btnSaveAsProfile.ForeColor = Get-ReadableTextColor -BackgroundColor $btnSaveAsProfile.BackColor
    }
    if ($btnSaveTabOrder) {
        $btnSaveTabOrder.ForeColor = Get-ReadableTextColor -BackgroundColor $btnSaveTabOrder.BackColor
    }
    if ($btnLoadProfile) {
        $btnLoadProfile.ForeColor = Get-ReadableTextColor -BackgroundColor $btnLoadProfile.BackColor
    }

    $mutedLabels = @(
        $lblSettingsHint, $lblThemeNote, $lblThemePreviewInfo, $lblTabLayoutHint,
        $lblPopupHint, $lblPopupTargetCount, $lblAcctPreview, $lblWelcome2,
        $lblHeaderRgb, $lblAccentRgb
    ) | Where-Object { $_ }
    foreach ($label in $mutedLabels) {
        $label.ForeColor = if ($script:IsDarkMode) { [System.Drawing.Color]::FromArgb(190, 196, 210) } else { [System.Drawing.Color]::FromArgb(90, 90, 90) }
    }
}

# -----------------------------
# Events - System Info / Popup
# -----------------------------
$btnSPing.Add_Click({ Invoke-PingButton -ComputerName $txtSComputer.Text.Trim() })

$btnSLoad.Add_Click({
    $computer = $txtSComputer.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($computer)) {
        Show-Error 'Enter a computer name first. What did you think would happen?'
        return
    }

    $tableSystemInfo.Rows.Clear()
    Write-Log "Loading system info from $computer..."

    try {
        if (-not (Test-RemoteAccess -ComputerName $computer -Credential $script:AdminCredential)) {
            return
        }

        $info = Get-RemoteSystemInfo -ComputerName $computer -Credential $script:AdminCredential

        $items = [ordered]@{
            'Computer Name' = [string]$info.ComputerName
            'Logged In User' = [string]$info.LoggedInUser
            'Model' = [string]$info.Model
            'Serial Number' = [string]$info.SerialNumber
            'OS Version' = [string]$info.OSVersion
            'Build Number' = [string]$info.BuildNumber
            'Last Boot' = if ($info.LastBoot) { (Get-Date $info.LastBoot -Format 'yyyy-MM-dd HH:mm:ss') } else { '' }
            'Uptime' = if ($info.LastBoot) { Format-Uptime -LastBoot ([datetime]$info.LastBoot) } else { '' }
            'IP Address' = [string]$info.IPAddress
            'C: Free Space (GB)' = [string]$info.FreeSpaceGB
            'C: Total Space (GB)' = [string]$info.TotalSpaceGB
            'BitLocker Status' = [string]$info.BitLocker
        }

        foreach ($key in $items.Keys) {
            $row = $tableSystemInfo.NewRow()
            $row['Property'] = $key
            $row['Value'] = [string]$items[$key]
            [void]$tableSystemInfo.Rows.Add($row)
        }

        Write-Log "Loaded system info from $computer." -Level Success
    }
    catch {
        Show-Error "Failed to load system info from $computer.`r`n$($_.Exception.Message)"
    }
})

$btnBrowseCompFile.Add_Click({
    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Filter = "Text Files (*.txt)|*.txt|All Files (*.*)|*.*"
    $dialog.Title = "Select a text file with computer names"
    if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $txtCompFilePath.Text = $dialog.FileName
        # Load file content into computers box too (for user visibility/edits)
        try {
            $fileList = Get-Content -Path $dialog.FileName | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }
            $txtPopupComputers.Text = ($fileList -join [Environment]::NewLine)
            Update-PopupTargetCountLabel -RawComputerInput $txtPopupComputers.Text -FilePathInput $txtCompFilePath.Text.Trim() -TargetLabel $lblPopupTargetCount
            Write-Log "Loaded computer list from $($dialog.FileName)." -Level Success
        }
        catch {
            Show-Error "Failed to read file: $($dialog.FileName).`r`n$($_.Exception.Message)"
        }
    }
})

$btnSendPopup.Add_Click({
    $raw = $txtPopupComputers.Text
    $file = $txtCompFilePath.Text.Trim()
    $computers = @()

    try {
        $computers = Get-ComputerTargetsFromInput -RawComputerInput $raw -FilePathInput $file
    }
    catch {
        Show-Error $_.Exception.Message
        return
    }

    if (-not $computers -or $computers.Count -eq 0) {
        Show-Error "Enter at least one computer name or provide a valid .txt file path."
        return
    }

    $msg = $txtPopupMsg.Text
    if ([string]::IsNullOrWhiteSpace($msg)) {
        Show-Error "Enter a popup message to send."
        return
    }
    $yesno = Show-YesNo "Send this popup to $($computers.Count) computer(s)?"
    if ($yesno -ne [System.Windows.Forms.DialogResult]::Yes) {
        Write-Log "Send popup cancelled by user." -Level Warn
        return
    }

    Write-Log "Sending popup to $($computers.Count) targets..."
    $sent = 0
    $fail = 0

    foreach ($comp in $computers) {
        if (Test-HostPing -ComputerName $comp) {
            $success = Invoke-RemotePopup -ComputerName $comp -Credential $script:AdminCredential -Message $msg
            if ($success) {
                Write-Log "Popup sent to $comp." -Level Success
                $sent++
            }
            else {
                Write-Log "Popup failed to $comp." -Level Error
                $fail++
            }
        } else {
            Write-Log "Ping failed for $comp. Skipping." -Level Error
            $fail++
        }
    }

    $resultMsg = "Popups sent: $sent`nFailed: $fail"
    Show-Info $resultMsg
    Write-Log $resultMsg
})

$txtPopupComputers.Add_TextChanged({
    Update-PopupTargetCountLabel -RawComputerInput $txtPopupComputers.Text -FilePathInput $txtCompFilePath.Text.Trim() -TargetLabel $lblPopupTargetCount
})

$txtCompFilePath.Add_TextChanged({
    Update-PopupTargetCountLabel -RawComputerInput $txtPopupComputers.Text -FilePathInput $txtCompFilePath.Text.Trim() -TargetLabel $lblPopupTargetCount
})

